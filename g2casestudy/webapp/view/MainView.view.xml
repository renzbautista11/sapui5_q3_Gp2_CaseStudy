<mvc:View controllerName="sapips.training.g2casestudy.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    core:require="{formatter: 'sapips/training/g2casestudy/model/formatter'}"
    >
    <Page id="page" title="{i18n>title}">
      <Table id="idMainViewTable" headerText="Orders" items="{path: '/Orders', sorter: {path: 'OrderID'} }">
       <columns>
        <Column id="idColumn1" minScreenWidth="Tablet" demandPopin="true">
         <Text id="idColTxtOrderNumber" text="{i18n>OrderNumber}"/>                     
        </Column>
        <Column id="idColumn2" minScreenWidth="Tablet" demandPopin="true">
         <Text id="idColTxtCreatedOn" text="{i18n>CreatedOn}"/>                     
        </Column>
        <Column id="idColumn3" minScreenWidth="Tablet" demandPopin="true">
         <Text id="idColTxtReceivingPlant" text="{i18n>ReceivingPlant}"/>                     
        </Column>
        <Column id="idColumn4" minScreenWidth="Tablet" demandPopin="true">
         <Text id="idColTxtDeliveringPlant" text="{i18n>DeliveringPlant}"/>                     
        </Column>
        <Column id="idColumn5" minScreenWidth="Tablet" demandPopin="true">
         <Text id="idColTxtStatus" text="{i18n>Status}"/>                     
        </Column>
       </columns>
       <items>
        <ColumnListItem id="idColumnListItem1">
         <cells>
          <Text id="idCellOrderID" text="{OrderID}"/>
          <Text id="idCellOrderDate" text="{ parts: [ {path: 'OrderDate'} ], formatter: 'formatter.formatDate' }"/>
          <Text id="idCellReceivingPlant" text="{ReceivingPlant}"/>
          <Text id="idCellDeliveringPlant" text="{DeliveringPlant}"/>
          <Text id="idCellStatus" text="{Status}"/>
         </cells>
        </ColumnListItem>
        </items>
      </Table>
    </Page>
</mvc:View>