<mvc:View
    controllerName="sapips.training.g2casestudy.controller.CreateView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        id="idCreatePage"
        title="{i18n>createTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <!-- order detail -->
            <VBox
                id="idVboxOrderSection"
                class="sapUiSmallMargin">

                <Panel
                    id="idPnlOrderDetail"
                    headerText="{i18n>orderDetail}">

                    <f:SimpleForm
                        id="idFrmOrderDetail"
                        editable="true"
                        layout="ResponsiveGridLayout">

                        <!-- receiving plant -->
                        <Label
                            id="idLblReceivingPlant"
                            text="{i18n>receivingPlant}"
                            required="true"/>

                        <Input
                            id="idInpReceivingPlant"
                            showValueHelp="true"
                            valueHelpRequest=".onValueHelpReceivingPlant"
                            placeholder="{i18n>selectPlant}"
                            width="25rem"/>

                        <!-- delivering plant -->
                        <Label
                            id="idLblDeliveringPlant"
                            text="{i18n>deliveringPlant}"
                            required="true"/>

                        <Input
                            id="idInpDeliveringPlant"
                            showValueHelp="true"
                            valueHelpRequest=".onValueHelpDeliveringPlant"
                            placeholder="{i18n>selectPlant}"
                            width="25rem"/>

                    </f:SimpleForm>
                </Panel>

            </VBox>

            <!-- product section -->
            <VBox
                id="idVboxProductSection"
                class="sapUiSmallMargin">

                <Panel id="idPnlProduct">

                    <headerToolbar>
                        <Toolbar id="idTlbProductHeader">

                            <Title
                                id="idTxtProductTitle"
                                text="{i18n>productSectionTitle}"
                                level="H5"/>

                            <ToolbarSpacer id="idTlbSpacerProduct"/>

                            <Button
                                id="idBtnAddProduct"
                                icon="sap-icon://add"
                                type="Transparent"
                                press=".onAddProduct"/>

                            <Button
                                id="idBtnDeleteProduct"
                                icon="sap-icon://delete"
                                type="Transparent"
                                press=".onDeleteProduct"/>

                        </Toolbar>
                    </headerToolbar>

                    <Table
                        id="idTblProduct"
                        mode="MultiSelect"
                        items="{/Products}">

                        <columns>
                            <Column id="idColProductName">
                                <Text
                                    id="idTxtProductName"
                                    text="{i18n>productName}"/>
                            </Column>

                            <Column id="idColQuantity">
                                <Text
                                    id="idTxtQuantity"
                                    text="{i18n>quantity}"/>
                            </Column>

                            <Column id="idColPrice">
                                <Text
                                    id="idTxtPrice"
                                    text="{i18n>pricePerQty}"/>
                            </Column>

                            <Column id="idColTotal">
                                <Text
                                    id="idTxtTotal"
                                    text="{i18n>totalPrice}"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem id="idCliProductRow">
                                <cells>
                                    <Text
                                        id="idTxtProductRowName"
                                        text="{ProductName}"/>

                                    <Text
                                        id="idTxtProductRowQty"
                                        text="{Quantity}"/>

                                    <Text
                                        id="idTxtProductRowPrice"
                                        text="{Price}"/>

                                    <Text
                                        id="idTxtProductRowTotal"
                                        text="{Total}"/>
                                </cells>
                            </ColumnListItem>
                        </items>

                    </Table>

                </Panel>
            </VBox>

        </content>

        <!-- footer -->
        <footer>
            <Toolbar id="idTlbFooter">

                <ToolbarSpacer id="idTlbSpacerFooter"/>

                <Button
                    id="idBtnSave"
                    text="{i18n>btnSave}"
                    type="Emphasized"
                    press=".onSave"/>

                <Button
                    id="idBtnCancel"
                    text="{i18n>btnCancel}"
                    type="Reject"
                    press=".onCancel"/>

            </Toolbar>
        </footer>

    </Page>
</mvc:View>