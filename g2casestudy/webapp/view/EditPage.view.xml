<!-- Edit Page
    Description: In this page, user should be able to edit an existing Product Order with the 
    associated list of products and amount.
 -->

<mvc:View controllerName="sapips.training.g2casestudy.controller.EditPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    
    <Page id="pageEP" title="{i18n>editPageTitle}" showNavButton="true" navButtonPress="onNavBack" floatingFooter="true">
        <content>

            <!-- ORDER DETAILS in Edit Page -->
            <Panel id="panelOrderDetailEP" headerText="{i18n>orderDetail}" class="sapUiResponsiveMargin" width="auto">

                <f:SimpleForm id="formOrderDetailEP" width="100%">

                    <Label id="lblOrderNumberEP" text="Order Number"/>
                    <Input id="inputOrderNumberEP" value="{edit>/Order/OrderID}" editable="false"/>

                    <Label id="lblCreatedOnEP" text="Created On"/>
                    <Input id="inputCreatedOnEP" value="{edit>/Order/OrderDateText}" editable="false"/>

                    <Label id="lblReceivingPlantEP" text="Receiving Plant"/>
                    <Input id="inputReceivingPlantEP" value="{edit>/Order/ReceivingPlant}" editable="false"/>

                    <Label id="lblDeliveringPlantEP" text="Delivering Plant"/>
                    <Input id="inputDeliveringPlantEP" value="{edit>/Order/DeliveringPlant}" editable="false"/>

                    <Label id="lblStatusEP" text="Status"/>
                    <Select id="selectStatusEP" selectedKey="{edit>/Order/Status}">
                        <items>
                            <core:Item id="itemCreatedEP" key="Created" text="Created"/>
                            <core:Item id="itemReleasedEP" key="Released" text="Released"/>
                            <core:Item id="itemPartiallyCompletedEP" key="PartiallyCompleted" text="Partially Completed"/>
                            <core:Item id="itemDeliveredEP" key="Delivered" text="Delivered"/>
                        </items>
                    </Select>

                </f:SimpleForm>

            </Panel>

            <!-- PRODUCT TABLE in Edit Page-->
            <Panel id="panelProductsEP" headerText="{= ${i18n>productsHeaderPrefix} + '(' + ${edit>/Items}.length + ')' }" 
                    class="sapUiResponsiveMargin" width="auto">

                <headerToolbar>
                    <OverflowToolbar id="oftPanelProductsEP">
                        <ToolbarSpacer id="tbsProductsEP"/>
                        <Button id="btnAddProductEP" icon="sap-icon://add" type="Transparent" press="onAddProduct"/>
                        <Button id="btnDeleteProductEP" icon="sap-icon://delete" type="Transparent" press="onDeleteProduct"/>
                    </OverflowToolbar>
                </headerToolbar>

                <Table
                    id="tableProductsEP"
                    items="{edit>/Items}"
                    mode="MultiSelect">

                    <columns>
                        <Column id="colProductNameEP">
                            <Text id="colTxtProductNameEP" text="Product Name"/>
                        </Column>
                        <Column id="colQuantityEP">
                            <Text id="colTxtQuantityEP" text="Quantity"/>
                        </Column>
                        <Column id="colUnitPriceEP">
                            <Text id="colTxtUnitPriceEP" text="Price Per Quantity"/>
                        </Column>
                        <Column id="colTotalPriceEP">
                            <Text id="colTxtTotalPriceEP" text="Total Price"/>
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="cliProductsEP" type="Active">
                            <cells>

                                <Text id="txtProductNameEP" text="{edit>ProductName}"/>
                                <Input id="ipQuantityEP" value="{edit>Quantity}" width="5rem" liveChange="onQuantityChange"/>
                                <Input id="ipUnitPriceEP" value="{edit>UnitPrice}" width="8rem"/>
                                <Text id="txtTotalPriceEP" text="{edit>TotalPrice}"/>

                            </cells>
                        </ColumnListItem>
                    </items>

                </Table>
            </Panel>
        </content>

        <!-- FOOTER in Edit Page-->
        <footer>
            <OverflowToolbar id="oftFooterEP" width="100%">

                <ToolbarSpacer id="tbsFooterEP"/>

                <Button
                    id="btnSaveEP"
                    text="Save"
                    type="Emphasized"
                    press="onSave"/>

                <Button
                    id="btnCancelEP"
                    text="Cancel"
                    type="Reject"
                    press="onCancel"/>

            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>